# Eumaeus production settings — copy to deploy/.env and fill in.
# Never commit deploy/.env.

# The public host name. DNS must point here; Caddy gets the certificate.
DOMAIN=eumaeus.example.com
# Let's Encrypt account email for expiry notices (optional, recommended).
# Use a real address — Let's Encrypt rejects example.com and the like.
ACME_EMAIL=

# Database password (any long random string).
POSTGRES_PASSWORD=
# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts mailbox passwords, OAuth tokens and webhook secrets. Back it up:
# without it those secrets can't be decrypted, even from a database backup.
SECRET_ENCRYPTION_KEY=
# Your Jev AI key (https://api.typesafe.ai).
JEV_API_KEY=

# The first administrator, created on first start only (never overwritten).
# Remove the password from this file after the first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# How many of the newest messages a new mailbox's first sync reads.
MAIL_INITIAL_SYNC_LIMIT=200

# Who is emailed when the background worker stops (and again when it is
# back), comma-separated. Empty = the system administrators' account
# addresses. Language of those emails: en or tr.
SYSTEM_ALERT_EMAILS=
SYSTEM_ALERT_LOCALE=en
# Minutes of worker silence before that email (0 = off).
WORKER_WATCHDOG_MINUTES=5

# New mail within seconds (one open IMAP connection per mailbox). Polling
# remains as a safety net every MAIL_POLL_FALLBACK_SECONDS.
MAIL_IDLE_ENABLED=true
MAIL_POLL_FALLBACK_SECONDS=300
MAIL_IDLE_MAX_CONNECTIONS=50

# Database backups: where on the host, how often, how long to keep.
BACKUP_PATH=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
