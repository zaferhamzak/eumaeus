# Copy this file to .env and fill in real values.
# Never commit .env — it is already gitignored at the repo root.

# --- Postgres ---
# If using docker-compose.yml at the repo root:
#   DATABASE_URL="postgresql://jev_mail:jev_mail@localhost:5432/jev_mail_dev"
# If using a native Homebrew Postgres with trust auth (no password), include your OS
# username explicitly — Prisma does not fall back to it the way `psql` does:
#   DATABASE_URL="postgresql://$(whoami)@localhost:5432/jev_mail_dev"
DATABASE_URL="postgresql://jev_mail:jev_mail@localhost:5432/jev_mail_dev"

# Used only by the integration test suite (a separate database so tests never touch
# your dev data). Created automatically by `pnpm prisma:migrate` if you point it here too.
DATABASE_URL_TEST="postgresql://jev_mail:jev_mail@localhost:5432/jev_mail_test"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Tenant bootstrap ---
# Phase 1 has no signup UI yet — this name is used to create/find the single
# bootstrap tenant that owns the mailbox connection below.
DEFAULT_TENANT_NAME="Local Dev Tenant"

# --- IMAP mailbox (primary V1 provider) ---
MAIL_HOST=mail.example.com
MAIL_PORT=993
MAIL_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX

# How many of the newest messages a mailbox's first sync reads (each one is sent
# to Jev). Unset = 200. "all" = everything currently in the folder.
MAIL_INITIAL_SYNC_LIMIT=

# How often (seconds) the durable reconciliation scheduler re-syncs the mailbox in
# the background, in addition to any manual `pnpm sync`. Keep this reasonable for
# your mail server — don't set it so low that it hammers IMAP.
MAIL_SYNC_INTERVAL_SECONDS=60
# New mail within seconds: one open IMAP connection (IDLE) per mailbox. While it
# is live, polling slows to MAIL_POLL_FALLBACK_SECONDS; if it drops, polling
# goes back to the interval above. MAIL_IDLE_MAX_CONNECTIONS caps open connections.
MAIL_IDLE_ENABLED=true
MAIL_POLL_FALLBACK_SECONDS=300
MAIL_IDLE_MAX_CONNECTIONS=50

# --- Jev (TypeSafe AI decision engine) ---
# Get a key from console.typesafe.ai. Never committed, never logged, never stored in
# the database — read directly from this env var at call time only.
JEV_API_KEY=

# Pinned model version — do NOT set this to "jev-latest". See config/env.ts for why.
JEV_MODEL_VERSION=jev-1.13.0

# Verified official endpoint base (docs.typesafe.ai/api.md, checked 2026-09-23).
# Only override this if you're pointing at a proxy/gateway.
JEV_API_BASE_URL=https://api.typesafe.ai

# Total retry budget (ms) for one analysis call, matching TypeSafe's own documented
# SDK default of 30 seconds.
JEV_TIMEOUT_MS=30000

# --- Phase 5B: Destination secrets (Webhook channel) ---
# Base64-encoded 256-bit AES-256-GCM key, used to encrypt webhook signing secrets
# before they are stored. Generate one with: openssl rand -base64 32
# Never commit a real value. Startup fails if this is missing or the wrong length.
SECRET_ENCRYPTION_KEY=

# Per-attempt HTTP timeout (ms) for the webhook destination executor.
WEBHOOK_TIMEOUT_MS=10000

# --- Phase 11: Authentication ---
# Redis-backed session lifetime (seconds), sliding — refreshed on every
# authenticated request.
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_NAME=jm_session
# Set to "false" ONLY for local plain-HTTP dev. Any real deployment must run
# this true, which requires serving the API over HTTPS.
SESSION_COOKIE_SECURE=true

# Optional. If both are set, the API creates a superAdmin User with this
# email/password once at startup (idempotent — never overwrites an existing
# user's password on restart). This is how you get your very first login on a
# fresh deployment; leave unset once you've bootstrapped and changed your
# password through the UI.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# The frontend's own public URL — used only to build the accept-invite link
# put in an invite email. Not the same thing as MAIL_HOST above (that's the
# INCOMING mailbox this product ingests).
APP_BASE_URL=http://localhost:3001

# --- Phase 11.1: outbound invite email (SMTP) ---
# Optional. Leave SMTP_HOST empty to disable email sending entirely — an
# invite still works, the admin just copies the link from the UI/API
# response and shares it manually instead. Use your own mailbox's SMTP
# submission settings, e.g.:
#   Gmail:     smtp.gmail.com, port 587, SMTP_SECURE=false (STARTTLS),
#              an App Password (not your normal password) as SMTP_PASSWORD
#   Hostinger: smtp.hostinger.com, port 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME if left empty — only set this separately if your
# provider allows sending "from" a different address than you log in with.
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Eumaeus

# Requests per minute per client address, shared by all API replicas.
RATE_LIMIT_PER_MINUTE=300
# Email the system administrators when the worker has been silent this many minutes (0 = off).
WORKER_WATCHDOG_MINUTES=5
# Who gets system emails such as "the worker has stopped" (comma-separated).
# Empty = the system administrators' account addresses.
SYSTEM_ALERT_EMAILS=
SYSTEM_ALERT_LOCALE=en
# Behind a reverse proxy: which proxies may set X-Forwarded-For (true, a hop count, or CIDRs).
TRUST_PROXY=
