{
  "name": "api",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "tsx --env-file=.env src/scripts/sync-once.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "api": "tsx --env-file=.env src/server.ts",
    "jev:smoke": "tsx --env-file=.env src/scripts/jev-smoke-test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@prisma/client": "^6.6.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.34.4",
    "fastify": "^5.12.5",
    "imapflow": "^1.0.176",
    "ioredis": "^5.4.2",
    "mailparser": "^3.7.2",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "prisma": "^6.6.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
